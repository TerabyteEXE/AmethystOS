#!/usr/bin/env bash
# Isolated fast shell mock of GSettings; deliberately not linked to user's GNOME.
set -euo pipefail
state="${KUHL_TEST_STATE:?}"
schema="${2:-}"; key="${3:-}"; ident="$schema/$key"
case "${1:-}" in
  list-keys)
    case "$schema" in
      org.gnome.desktop.interface) printf '%s\n' color-scheme icon-theme gtk-theme accent-color font-name document-font-name monospace-font-name cursor-theme;;
      org.gnome.desktop.background) printf '%s\n' picture-uri picture-uri-dark;;
      org.gnome.desktop.wm.preferences) printf '%s\n' titlebar-font;;
      org.gnome.shell.keybindings) printf '%s\n' toggle-overview;;
      org.gnome.shell.extensions.user-theme) printf '%s\n' name;;
    esac
    ;;
  get)
    if [[ -e "$state" ]]; then
      result="$(awk -F '\t' -v k="$ident" '$1==k {print $2}' "$state")"
      if [[ -n "$result" ]]; then printf '%s\n' "$result"; exit 0; fi
    fi
    case "$ident" in
      org.gnome.desktop.interface/color-scheme) echo "'default'";;
      org.gnome.desktop.interface/gtk-theme) echo "'Adwaita'";;
      org.gnome.desktop.interface/icon-theme) echo "'Adwaita'";;
      org.gnome.shell.extensions.user-theme/name) echo "''";;
      *) echo "'default'";;
    esac
    ;;
  set)
    [[ $# -eq 4 ]] || exit 2
    mkdir -p "$(dirname "$state")"
    tmp="$state.new"
    if [[ -e "$state" ]]; then awk -F '\t' -v k="$ident" '$1!=k {print}' "$state" > "$tmp"; else : > "$tmp"; fi
    printf '%s\t%s\n' "$ident" "$4" >> "$tmp"
    mv "$tmp" "$state"
    ;;
  *) exit 2;;
esac
