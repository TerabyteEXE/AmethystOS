# ╔══════════════════════════════════════════════╗
# ║  mako/config — sakura rice                 ║
# ╚══════════════════════════════════════════════╝

sort=-time
layer=overlay
anchor=top-right

# Geometry
width=260
height=90
margin=14
padding=8,8

# Style
background-color=#faf7ffee
text-color=#302747
border-size=2
border-color=#8160aacc
border-radius=8

# Icons
icons=1
max-icon-size=44
icon-path=/usr/share/icons/Papirus

# Text
font=Cascadia Mono NF 11
markup=1
actions=1
format=<b>%s</b>\n%b

# Behaviour
default-timeout=5000
ignore-timeout=0
max-visible=5

# Progress bar (für media notifications)
[hidden]
format=(+%i more)
text-color=#302747

[urgency=low]
border-color=#8160aacc
default-timeout=3000

[urgency=normal]
border-color=#8160aacc
default-timeout=5000

[urgency=high]
border-color=#8160aacc
background-color=#faf7ffee
default-timeout=0
