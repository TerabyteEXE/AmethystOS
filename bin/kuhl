#!/usr/bin/env bash
# KUHL-MANAGED — original Kuhl OS desktop control CLI
set -Eeuo pipefail
ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/kuhl"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/kuhl"
THEME_FILE="$STATE/theme"
SELF="$HOME/.local/bin/kuhl"
mkdir -p "$STATE"
command_name="${1:-help}"
[[ $# -eq 0 ]] || shift
in_niri() { [[ "${XDG_CURRENT_DESKTOP:-}" == *niri* || "${XDG_CURRENT_DESKTOP:-}" == *Niri* || -n "${NIRI_SOCKET:-}" ]]; }

show_ui() {
  local name="$1"; shift
  [[ -r "$ROOT/kuhl_ui.py" ]] || { echo 'Kuhl interface not installed.' >&2; exit 1; }
  if command -v kitty >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
    # Separate Kuhl panel window so it floats automatically under Niri.
    kitty --class "kuhl-${name}" --title "Kuhl OS / ${name}" \
      -o font_size=11.5 -o initial_window_width=790 -o initial_window_height=580 \
      -e python3 "$ROOT/kuhl_ui.py" "$name" "$@"
  else
    python3 "$ROOT/kuhl_ui.py" "$name" "$@"
  fi
}

apply_wallpaper() {
  if ! in_niri; then echo 'Wallpaper choice saved. Apply when logged into Niri.'; return 0; fi
  command -v swaybg >/dev/null 2>&1 || { echo 'swaybg is not installed.' >&2; return 1; }
  local choice img bg pid oldcmd theme_now gif
  choice="$(cat "$STATE/wallpaper-choice" 2>/dev/null || echo auto)"
  if [[ "$choice" == custom ]]; then
    img="$(cat "$STATE/wallpaper-custom" 2>/dev/null || true)"
  else
    case "$choice" in
      day) img="$ROOT/wallpapers/kuhl-day.png";;
      dusk) img="$ROOT/wallpapers/kuhl-dusk.png";;
      default) img="$ROOT/wallpapers/kuhl-default.png";;
      auto) 
        theme_now="$(cat "$THEME_FILE" 2>/dev/null || echo frontier)"
        img="$(python3 - "$ROOT/themes.json" "$theme_now" <<'PYCODE'
import json,sys
from pathlib import Path
try:
    data=json.loads(Path(sys.argv[1]).read_text()); print(data.get(sys.argv[2],{}).get('wallpaper',''))
except (OSError,ValueError): print('')
PYCODE
)"
        [[ -z "$img" ]] || img="$ROOT/wallpapers/$img"
        ;;
      solid) img='';;
      *) echo 'Unrecognized wallpaper setting; using solid background.' >&2; img='';;
    esac
  fi
  # When a user installs awww separately, the original KyleOS animated wallpaper is
  # available. Fedora's official swaybg remains the guaranteed static fallback.
  if [[ "$choice" == auto && -n "$img" && "${KUHL_ANIMATED_WALLPAPER:-0}" == 1 ]] && command -v awww >/dev/null 2>&1; then
    gif="${img%.png}.gif"
    if [[ -r "$gif" ]]; then
      awww-daemon >/dev/null 2>&1 &
      awww img "$gif" --transition-type wipe --transition-duration 0.2 || true
      return 0
    fi
  fi
  if [[ -n "$img" && ! -r "$img" ]]; then
    echo "Cannot read wallpaper: $img. Using solid background." >&2
    img=''
  fi
  # Stop only the background process Kuhl itself started.
  if [[ -r "$STATE/swaybg.pid" ]]; then
    pid="$(cat "$STATE/swaybg.pid")"
    if [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]]; then
      oldcmd="$(tr '\0' ' ' < "/proc/$pid/cmdline")"
      if [[ "$oldcmd" == swaybg\ * || "$oldcmd" == */swaybg\ * ]]; then
        kill "$pid" 2>/dev/null || true
      fi
    fi
  fi
  if [[ -n "$img" ]]; then
    swaybg -i "$img" -m fill >/dev/null 2>&1 &
  else
    local color
    color="$(python3 - "$ROOT/themes.json" "$(cat "$THEME_FILE" 2>/dev/null || echo frontier)" <<'PYCODE'
import json,sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2],{}).get('bg','#0b0d15'))
except (OSError,ValueError):print('#0b0d15')
PYCODE
)"
    swaybg -c "$color" >/dev/null 2>&1 &
  fi
  printf '%s\n' "$!" > "$STATE/swaybg.pid"
}

case "$command_name" in
  theme)
    if [[ "${1:-}" == list ]]; then
      python3 - "$ROOT/themes.json" <<'PYCODE'
import json,sys
for key,info in json.load(open(sys.argv[1])).items():print(f"{key:12} {info['name']}")
PYCODE
      exit 0
    fi
    [[ $# -eq 1 ]] || { echo 'Usage: kuhl theme list|THEME' >&2; exit 2; }
    python3 - "$ROOT/themes.json" "$1" <<'PYCODE'
import json,sys
if sys.argv[2] not in json.load(open(sys.argv[1])): raise SystemExit('Unknown Kuhl theme. Run: kuhl theme list')
PYCODE
    [[ -r "$ROOT/render.py" ]] || { echo 'Kuhl desktop is not installed.' >&2; exit 1; }
    python3 "$ROOT/render.py" theme --theme "$1"
    if in_niri; then
      pkill -USR2 -u "$(id -u)" -x waybar 2>/dev/null || true
      if [[ -r "$ROOT/desktop.py" ]]; then python3 "$ROOT/desktop.py" appearance apply "$1" || true; fi
      if command -v makoctl >/dev/null 2>&1; then makoctl reload >/dev/null 2>&1 || true; fi
      "$SELF" wallpaper apply || true
      # Vicinae may need its built-in theme selector on some versions.
    fi
    printf 'Kuhl %s palette activated (edited personal configs are preserved).\n' "$1"
    ;;
  themes)
    [[ "${1:-}" == --ui ]] || { echo 'Usage: kuhl themes --ui' >&2; exit 2; }
    if ! command -v rofi >/dev/null 2>&1; then
      "$SELF" menu --ui --page themes
      exit 0
    fi
    # This only consumes known IDs from the installed Kuhl theme manifest.
    chosen="$(python3 - "$ROOT/themes.json" "$ROOT/wallpapers" "$HOME/.config/rofi/gallery.rasi" <<'PYCODE'
import json,subprocess,sys
from pathlib import Path
palettes=json.load(open(sys.argv[1])); wallpapers=Path(sys.argv[2])
items=[];names={}
for key,p in palettes.items():
    name=p['name']; names[name]=key
    art=p.get('wallpaper') or ('kuhl-day.png' if key=='day' else 'kuhl-dusk.png')
    path=wallpapers/art
    items.append(f"{name}\0icon\x1f{path}" if path.is_file() else name)
try:
    proc=subprocess.run(['rofi','-dmenu','-i','-no-custom','-show-icons','-p','Kuhl themes','-theme',sys.argv[3]],input='\n'.join(items)+'\n',text=True,capture_output=True,check=False)
    if proc.returncode==0:print(names.get(proc.stdout.strip(),''))
except OSError: pass
PYCODE
)"
    [[ -n "$chosen" ]] && "$SELF" theme "$chosen"
    ;;
  launcher)
    if [[ "${1:-}" == vicinae ]] && command -v vicinae >/dev/null 2>&1; then
      exec vicinae toggle
    fi
    if command -v rofi >/dev/null 2>&1; then
      exec rofi -show drun -theme "$HOME/.config/rofi/kuhl.rasi"
    fi
    command -v fuzzel >/dev/null 2>&1 && exec fuzzel
    echo 'No launcher installed. Run: sudo dnf install fuzzel' >&2; exit 1
    ;;
  bar|ui|display|appearance)
    [[ -f "$ROOT/desktop.py" ]] || { echo 'Kuhl desktop settings component missing. Reinstall Kuhl.' >&2; exit 1; }
    exec python3 "$ROOT/desktop.py" "$command_name" "$@"
    ;;
  window)
    [[ "${1:-}" == close ]] || { echo 'Usage: kuhl window close' >&2; exit 2; }
    exec niri msg action close-window
    ;;
  settings)
    category="${1:-menu}"
    [[ $# -eq 0 ]] || shift
    case "$category" in
      menu) show_ui control menu --page settings;;
      bar) show_ui control menu --page bar;;
      ui) show_ui control menu --page ui;;
      network)
        if command -v nm-connection-editor >/dev/null 2>&1; then exec nm-connection-editor; fi
        if command -v nmtui >/dev/null 2>&1; then exec nmtui; fi
        echo 'Network editor unavailable. Install: sudo dnf install nm-connection-editor' >&2; exit 1;;
      audio)
        command -v pavucontrol >/dev/null 2>&1 && exec pavucontrol
        echo 'Audio settings unavailable. Install: sudo dnf install pavucontrol' >&2; exit 1;;
      bluetooth)
        command -v blueman-manager >/dev/null 2>&1 && exec blueman-manager
        echo 'Bluetooth settings unavailable. Install: sudo dnf install blueman' >&2; exit 1;;
      display)
        exec python3 "$ROOT/desktop.py" display wizard;;
      apps)
        exec gnome-control-center applications;;
      *) echo 'Usage: kuhl settings [network|audio|bluetooth|display|bar|ui|apps]' >&2; exit 2;;
    esac
    ;;
  wallpaper)
    op="${1:-help}"; [[ $# -eq 0 ]] || shift
    case "$op" in
      set)
        [[ $# -eq 1 ]] || { echo 'Usage: kuhl wallpaper set /full/path/to/image.png' >&2; exit 2; }
        [[ -f "$1" && -r "$1" ]] || { echo "Wallpaper not found: $1" >&2; exit 1; }
        case "${1,,}" in *.png|*.jpg|*.jpeg|*.webp) ;; *) echo 'Use a PNG, JPG or WebP wallpaper.' >&2; exit 2;; esac
        realpath -e -- "$1" > "$STATE/wallpaper-custom"
        printf 'custom\n' > "$STATE/wallpaper-choice"
        apply_wallpaper
        ;;
      reset|auto) printf 'auto\n' > "$STATE/wallpaper-choice"; apply_wallpaper;;
      solid) printf 'solid\n' > "$STATE/wallpaper-choice"; apply_wallpaper;;
      day|dusk|default) printf '%s\n' "$op" > "$STATE/wallpaper-choice"; apply_wallpaper;;
      apply) apply_wallpaper;;
      *) echo 'Usage: kuhl wallpaper set PATH|reset|solid|day|dusk|default|apply' >&2; exit 2;;
    esac
    ;;
  keys)
    if [[ "${1:-}" == --ui ]]; then
      shift
      show_ui keys "$@"
    else
      python3 - "$ROOT/keys.json" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1]);d=json.loads(p.read_text())
for section in d['sections']:
 print(f'\n  {section.upper()}')
 for row in [r for r in d['bindings'] if r['section']==section]:
  print(f'  {row["show"]:<25}  {row["title"]}')
print('\n  Ctrl + Super + K  ·  Open searchable guide in Niri')
PY
    fi
    ;;
  menu)
    [[ "${1:-}" == --ui ]] && shift
    [[ $# -eq 0 || ( $# -eq 2 && "$1" == --page ) ]] || { echo 'Usage: kuhl menu [--ui] [--page main|themes|power]' >&2; exit 2; }
    show_ui control menu "$@"
    ;;
  status)
    echo 'Kuhl OS v1.0 RC2 · stabilized KyleOS rice · Fedora + Niri'
    echo "Theme: $(cat "$THEME_FILE" 2>/dev/null || echo not-installed)"
    echo "Desktop: ${XDG_CURRENT_DESKTOP:-unknown}"
    echo "Launcher: $(command -v rofi >/dev/null && echo 'Rofi (KyleOS)' || echo 'Fuzzel fallback')"
    echo "Wallpaper: $(cat "$STATE/wallpaper-choice" 2>/dev/null || echo auto)"
    [[ ! -r "$ROOT/desktop.py" ]] || python3 "$ROOT/desktop.py" bar show
    [[ ! -f "$ROOT/render.py" ]] || python3 "$ROOT/render.py" status
    ;;
  doctor)
    problems=0
    [[ -r /etc/fedora-release ]] && echo '[ok] Fedora found' || { echo '[warn] Not running Fedora'; problems=$((problems+1)); }
    for c in niri waybar rofi fuzzel kitty alacritty mako swaybg swaylock swayidle python3 thunar nm-connection-editor pavucontrol gsettings; do
      command -v "$c" >/dev/null 2>&1 && echo "[ok] $c" || { echo "[warn] Missing $c"; problems=$((problems+1)); }
    done
    if command -v niri >/dev/null 2>&1; then
      niri validate && echo '[ok] Niri configuration valid' || { echo '[warn] Niri validation failed'; problems=$((problems+1)); }
    fi
    [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl" ]] || { echo '[warn] Niri config absent'; problems=$((problems+1)); }
    [[ -r "$ROOT/desktop.py" ]] && echo '[ok] Kuhl settings component installed' || { echo '[warn] Kuhl settings component missing'; problems=$((problems+1)); }
    [[ -r "$ROOT/keys.json" ]] && echo '[ok] Searchable Kuhl keyboard reference present' || { echo '[warn] Kuhl keys missing'; problems=$((problems+1)); }
    [[ -n "${NIRI_SOCKET:-}" ]] && echo '[ok] Running Niri session' || echo '[info] Log into Niri to test the session'
    printf '%s concern(s) detected.\n' "$problems"
    (( problems==0 ))
    ;;
  uninstall)
    [[ $# -eq 0 ]] || { echo 'Usage: kuhl uninstall' >&2; exit 2; }
    echo 'Restoring only unchanged Kuhl-managed configuration files...'
    [[ ! -r "$ROOT/desktop.py" ]] || python3 "$ROOT/desktop.py" appearance restore || true
    [[ ! -r "$ROOT/render.py" ]] || python3 "$ROOT/render.py" uninstall || true
    rm -f -- "$SELF"
    echo 'Kuhl command removed. Fedora, GNOME, RPMs, wallpaper assets and backups remain.'
    ;;
  help|-h|--help)
    cat <<'HELP'
KUHL OS · 1.0 STABILIZATION BUILD · KYLEOS RICE
  kuhl menu                         Keyboard-operated desktop control center
  kuhl settings                     Settings menu (network, sound, Bluetooth, display, scale)
  kuhl display outputs              List current Niri monitors
  kuhl display wizard               Guided monitor scaling on connected displays
  kuhl display scale eDP-1 1.25     Set monitor scaling; automatically validated
  kuhl display reset                Reset monitor scaling to automatic
  kuhl ui scale 125                 Application / terminal text scale (percentage)
  kuhl bar scale 125                Resize top bar to 125%
  kuhl bar position bottom          Move bar to bottom
  kuhl bar module workspaces on     Show workspaces in bar
  kuhl bar module close off         Hide click-to-close control
  kuhl bar reset                    Restore default bar layout
  kuhl window close                 Close focused Niri window
  kuhl themes --ui                  Graphical theme gallery (Super+Shift+T)
  kuhl keys --ui                    Searchable shortcut atlas · Ctrl+Super+K
  kuhl keys                         Print every shortcut
  kuhl launcher                     KyleOS Rofi / Fuzzel search · Super+Space
  kuhl launcher vicinae             Optional Vicinae if installed
  kuhl theme list                   List available themes
  kuhl theme frontier|dyson|puncture|slowend|day|dusk  Apply a palette
  kuhl wallpaper set /path/image   Bring your own wallpaper
  kuhl wallpaper reset             Restore theme artwork (or solid Day/Dusk)
  kuhl wallpaper day|dusk|default  Use previous Kuhl images (optional)
  kuhl doctor                       Diagnose installed desktop
  kuhl status                       Managed-file status
  kuhl uninstall                    Restore unchanged managed dotfiles

No background updater or bundled AI runtime. Some project code was AI-assisted. Review scripts before use. GNOME is kept for recovery.
HELP
    ;;
  *) echo "Unknown command: $command_name (run: kuhl help)" >&2; exit 2;;
esac
