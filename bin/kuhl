#!/usr/bin/env bash
# KUHL-MANAGED - Kuhl OS 0.6 management command
set -Eeuo pipefail
ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/kuhl"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/kuhl"
THEME_FILE="$STATE/theme"
command_name="${1:-help}"
[[ $# -eq 0 ]] || shift
case "$command_name" in
  theme)
    [[ $# -eq 1 && ( "$1" == day || "$1" == dusk ) ]] || { echo 'Usage: kuhl theme day|dusk' >&2; exit 2; }
    [[ -f "$ROOT/render.py" ]] || { echo 'Kuhl desktop is not installed.' >&2; exit 1; }
    python3 "$ROOT/render.py" theme --theme "$1"
    if [[ "${XDG_CURRENT_DESKTOP:-}" == *niri* || -n "${NIRI_SOCKET:-}" ]]; then
      pkill -USR2 -u "$(id -u)" -x waybar 2>/dev/null || true
      if command -v makoctl >/dev/null 2>&1; then makoctl reload >/dev/null 2>&1 || true; fi
      "$HOME/.local/bin/kuhl" wallpaper apply || true
      if command -v vicinae >/dev/null 2>&1; then
        vicinae "vicinae://theme/set/kuhl-${1}" >/dev/null 2>&1 || true
      fi
    fi
    printf 'Kuhl %s applied (existing user-edited configs are left untouched).\n' "$1"
    ;;
  launcher)
    if command -v vicinae >/dev/null 2>&1; then
      vicinae toggle || fuzzel
    else
      exec fuzzel
    fi
    ;;
  wallpaper)
    [[ $# -eq 1 ]] || { echo 'Usage: kuhl wallpaper apply|default|day|dusk' >&2; exit 2; }
    case "$1" in
      default|day|dusk) printf '%s\n' "$1" > "$STATE/wallpaper-choice"; set -- apply ;;
      apply) ;;
      *) echo 'Usage: kuhl wallpaper apply|default|day|dusk' >&2; exit 2;;
    esac
    [[ "${XDG_CURRENT_DESKTOP:-}" == *niri* || -n "${NIRI_SOCKET:-}" ]] || { echo 'Wallpaper choice saved. Apply while logged into Niri.'; exit 0; }
    choice="$(cat "$STATE/wallpaper-choice" 2>/dev/null || echo auto)"
    if [[ "$choice" == auto ]]; then choice="$(cat "$THEME_FILE" 2>/dev/null || echo dusk)"; fi
    case "$choice" in
      day) img="$ROOT/wallpapers/kuhl-day.png" ;;
      dusk) img="$ROOT/wallpapers/kuhl-default.png" ;;
      default) img="$ROOT/wallpapers/kuhl-default.png" ;;
      *) echo 'Invalid wallpaper setting' >&2; exit 1;;
    esac
    [[ -r "$img" ]] || { echo "Missing wallpaper: $img" >&2; exit 1; }
    if [[ -f "$STATE/swaybg.pid" ]]; then
      pid="$(cat "$STATE/swaybg.pid")"
      if [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]] &&
         tr '\0' ' ' < "/proc/$pid/cmdline" | grep -Fq "swaybg -i $ROOT/wallpapers/"; then
        kill "$pid" 2>/dev/null || true
      fi
    fi
    swaybg -i "$img" -m fill >/dev/null 2>&1 &
    echo "$!" > "$STATE/swaybg.pid"
    ;;
  keys)
    cat <<'TXT'
KUHL OS · KEYBOARD
  Super + Space     Search (Vicinae if installed, otherwise Fuzzel)
  Super + Enter/T   Terminal       Super + E         Files
  Super + H / L     Focus left/right column
  Super + J / K     Focus down/up window
  Super + Ctrl + H/J/K/L   Move columns or windows
  Super + 1..5      Switch workspace
  Super + Shift + 1..5   Move current column to workspace
  Super + F         Maximize column
  Super + Shift + F Fullscreen window
  Super + R         Change column width
  Super + V         Toggle floating
  Super + Shift + Q Close window
  Super + Shift + L Lock
  Super + Shift + E Exit Niri (with confirmation)
  Super + Shift + / Show Niri's shortcut overlay
  Print             Screenshot
TXT
    ;;
  status)
    echo 'Kuhl OS 0.6 — Fedora + Niri desktop edition'
    echo "Theme: $(cat "$THEME_FILE" 2>/dev/null || echo not-installed)"
    echo "Desktop: ${XDG_CURRENT_DESKTOP:-unknown}"
    echo "Launcher: $(command -v vicinae >/dev/null && echo Vicinae || echo 'Fuzzel fallback')"
    echo "Configs: ${XDG_CONFIG_HOME:-$HOME/.config}/{niri,waybar,kitty,mako}"
    [[ ! -f "$ROOT/render.py" ]] || python3 "$ROOT/render.py" status
    ;;
  doctor)
    problems=0
    [[ -r /etc/fedora-release ]] && echo '[ok] Fedora detected' || { echo '[warn] Not Fedora'; problems=$((problems+1)); }
    for cmd in niri waybar fuzzel kitty mako swaybg swaylock swayidle python3; do
      command -v "$cmd" >/dev/null 2>&1 && echo "[ok] $cmd" || { echo "[warn] Missing $cmd"; problems=$((problems+1)); }
    done
    if command -v niri >/dev/null 2>&1; then
      niri validate && echo '[ok] Niri KDL validates' || { echo '[warn] Niri configuration failed validation'; problems=$((problems+1)); }
    fi
    [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl" ]] || { echo '[warn] Niri user config not installed'; problems=$((problems+1)); }
    if command -v vicinae >/dev/null; then echo '[ok] Optional Vicinae installed'; else echo '[info] Fuzzel is used for search'; fi
    [[ -n "${NIRI_SOCKET:-}" ]] && echo '[ok] Running Niri session' || echo '[info] Log into Niri from your login screen to test the actual desktop'
    printf '%s check(s) require attention.\n' "$problems"
    (( problems == 0 ))
    ;;
  uninstall)
    [[ $# -eq 0 ]] || { echo 'Usage: kuhl uninstall' >&2; exit 2; }
    echo 'Removing only Kuhl-tracked desktop configs (edited files are preserved)...'
    [[ ! -r "$ROOT/render.py" ]] || python3 "$ROOT/render.py" uninstall || true
    rm -f "$HOME/.local/bin/kuhl"
    echo "Kuhl management command removed. Fedora packages, third-party repos, GNOME and previous GNOME Kuhl settings were NOT removed."
    echo "Kuhl assets and backups remain in $ROOT and $STATE for safe inspection."
    ;;
  help|-h|--help)
    cat <<'TXT'
KUHL OS 0.6 · Fedora + Niri
  kuhl theme day|dusk        Apply matching Waybar, Niri, Kitty and Mako palette
  kuhl wallpaper day|dusk|default|apply
  kuhl launcher               Vicinae search, or Fuzzel fallback
  kuhl keys                   Show keyboard cheat sheet
  kuhl status                 Show managed config state
  kuhl doctor                 Check installed desktop and configuration
  kuhl uninstall              Remove/restore only unmodified Kuhl configs

  Re-run the local install.sh to update. No background auto-update, AI or telemetry.
TXT
    ;;
  *) echo "Unknown command: $command_name (run: kuhl help)" >&2; exit 2 ;;
esac
