  "bindings": [
    {
      "section": "Start here",
      "key": "Mod+Space",
      "show": "Super + Space",
      "title": "Search apps and files",
      "action": "spawn \"sh\" \"-c\" \"$HOME/.local/bin/kuhl launcher\";"
    },
    {
      "section": "Start here",
      "key": "Mod+Return",
      "show": "Super + Enter",
      "title": "Open Alacritty",
      "action": "spawn \"sh\" \"-c\" \"alacritty\";"
    },
    {
      "section": "Start here",
      "key": "Mod+Alt+Return",
      "show": "Super + Alt + Enter",
      "title": "Open Kitty",
      "action": "spawn \"sh\" \"-c\" \"kitty\";"
    },
    {
      "section": "Start here",
      "key": "Mod+B",
      "show": "Super + B",
      "title": "Open web browser",
      "action": "spawn \"sh\" \"-c\" \"firefox\";"
    },
    {
      "section": "Start here",
      "key": "Mod+E",
      "show": "Super + E",
      "title": "Open file manager",
      "action": "spawn \"sh\" \"-c\" \"thunar\";"
    },
    {
      "section": "Start here",
      "key": "Mod+D",
      "show": "Super + D",
      "title": "Kuhl Control Center",
      "action": "spawn \"sh\" \"-c\" \"$HOME/.local/bin/kuhl menu --ui\";"
    },
    {
      "section": "Start here",
      "key": "Mod+Shift+S",
      "show": "Super + Shift + S",
