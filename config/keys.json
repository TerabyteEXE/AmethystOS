{
  "sections": [
    "Start here",
    "Windows",
    "Workspaces",
    "System & media"
  ],
  "bindings": [
    {
      "section": "Start here",
      "key": "Alt+K",
      "show": "Alt + K",
      "title": "Application launcher",
      "action": "spawn \"sh\" \"-c\" \"$HOME/.local/bin/kuhl launcher\";"
    },
    {
      "section": "System & media",
      "key": "Scroll_Lock",
      "show": "Scroll_Lock",
      "title": "Lock screen",
      "action": "spawn \"swaylock\" \"-f\" \"-c\" \"0a0a10\";"
    },
    {
      "section": "Start here",
      "key": "Mod+T",
      "show": "Super + T",
      "title": "Theme gallery",
      "action": "spawn \"sh\" \"-c\" \"$HOME/.local/bin/kuhl themes --ui\";"
    },
    {
      "section": "Start here",
      "key": "Mod+Return",
      "show": "Super + Enter",
      "title": "Alacritty terminal",
      "action": "spawn \"alacritty\";"
    },
    {
      "section": "Start here",
      "key": "Mod+D",
      "show": "Super + D",
      "title": "Kuhl Control Center",
      "action": "spawn \"sh\" \"-c\" \"$HOME/.local/bin/kuhl menu --ui\";"
    },
    {
      "section": "Start here",
      "key": "Mod+B",
      "show": "Super + B",
      "title": "Firefox",
      "action": "spawn \"firefox\";"
    },
    {
      "section": "System & media",
      "key": "Super+Alt+L",
      "show": "Super + Alt + L",
      "title": "Lock the screen",
      "action": "spawn \"swaylock\" \"-f\" \"-c\" \"0a0a10\";"
    },
    {
      "section": "System & media",
      "key": "Ctrl+Alt+Delete",
      "show": "Ctrl + Alt + Delete",
      "title": "Power menu",
      "action": "spawn \"sh\" \"-c\" \"$HOME/.local/bin/kuhl menu --ui --page power\";"
    },
    {
      "section": "Windows",
      "key": "Mod+Shift+E",
      "show": "Super + Shift + E",
      "title": "Power menu",
      "action": "spawn \"sh\" \"-c\" \"$HOME/.local/bin/kuhl menu --ui --page power\";"
    },
    {
      "section": "Windows",
      "key": "Super+Alt+S",
      "show": "Super + Alt + S",
      "title": "Spawn sh",
      "action": "spawn-sh \"pkill orca || exec orca\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioMute",
      "show": "XF86AudioMute",
      "title": "Spawn sh",
      "action": "spawn-sh \"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioRaiseVolume",
      "show": "XF86AudioRaiseVolume",
      "title": "Spawn sh",
      "action": "spawn-sh \"wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01+ -l 1.0\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioLowerVolume",
      "show": "XF86AudioLowerVolume",
      "title": "Spawn sh",
      "action": "spawn-sh \"wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01-\";"
    },
    {
      "section": "System & media",
      "key": "XF86MonBrightnessUp",
      "show": "XF86MonBrightnessUp",
      "title": "Spawn",
      "action": "spawn \"brightnessctl\" \"--class=backlight\" \"set\" \"+10%\";"
    },
    {
      "section": "System & media",
      "key": "XF86MonBrightnessDown",
      "show": "XF86MonBrightnessDown",
      "title": "Spawn",
      "action": "spawn \"brightnessctl\" \"--class=backlight\" \"set\" \"10%-\";"
    },
    {
      "section": "System & media",
