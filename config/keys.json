    {
      "section": "System & media",
      "key": "Super+Alt+L",
      "show": "Super + Alt + L",
      "title": "Lock screen",
      "action": "spawn \"sh\" \"-c\" \"swaylock -f -c 1e1e2e\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioRaiseVolume",
      "show": "Volume up key",
      "title": "Volume up",
      "action": "spawn \"sh\" \"-c\" \"wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioLowerVolume",
      "show": "Volume down key",
      "title": "Volume down",
      "action": "spawn \"sh\" \"-c\" \"wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioMute",
      "show": "Mute key",
      "title": "Mute audio",
      "action": "spawn \"sh\" \"-c\" \"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioMicMute",
      "show": "Microphone mute",
      "title": "Mute microphone",
      "action": "spawn \"sh\" \"-c\" \"wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioPlay",
      "show": "Play key",
      "title": "Play or pause media",
      "action": "spawn \"sh\" \"-c\" \"playerctl play-pause\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioNext",
      "show": "Next track",
      "title": "Next track",
      "action": "spawn \"sh\" \"-c\" \"playerctl next\";"
    },
    {
      "section": "System & media",
      "key": "XF86AudioPrev",
      "show": "Previous track",
      "title": "Previous track",
      "action": "spawn \"sh\" \"-c\" \"playerctl previous\";"
    },
