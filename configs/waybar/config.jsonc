{
  "// kuhl-managed": "Kuhl OS Frontier / MIT-inspired KyleOS reference: full-width, simple status line",
  "layer": "top",
  "position": "top",
  "height": 29,
  "exclusive": true,
  "reload_style_on_change": true,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [
    "custom/kuhl",
    "niri/workspaces",
    "pulseaudio",
    "battery"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "tray",
    "custom/theme",
    "custom/keys",
    "custom/power"
  ],
  "custom/kuhl": {
    "format": "✳ KUHL",
    "tooltip": "Control center · Super+D",
    "on-click": "sh -c '$HOME/.local/bin/kuhl menu --ui'"
  },
  "niri/workspaces": {
    "format": "{index}",
    "all-outputs": false,
    "on-click": "activate"
  },
  "clock": {
    "format": "{:%Y.%m.%d  —  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "pulseaudio": {
    "format": "♪ {volume}%",
    "format-muted": "♪ mute",
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
  },
  "network": {
    "format-wifi": "wifi {essid}",
    "format-ethernet": "wired",
    "format-disconnected": "offline",
    "tooltip": true,
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "▰ {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "states": {
      "warning": 25,
      "critical": 12
    }
  },
  "tray": {
    "spacing": 5
  },
  "custom/theme": {
    "format": "◈",
    "tooltip": "Themes · Super+Shift+T",
    "on-click": "sh -c '$HOME/.local/bin/kuhl themes --ui'"
  },
  "custom/keys": {
    "format": "?",
    "tooltip": "Shortcuts · Ctrl+Super+K",
    "on-click": "sh -c '$HOME/.local/bin/kuhl keys --ui'"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": "Power & session",
    "on-click": "sh -c '$HOME/.local/bin/kuhl menu --ui --page power'"
  }
}
