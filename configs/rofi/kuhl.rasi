@import "config.rasi"
@import "color.rasi"
window { width: 620px; border: 2px; border-color: @accent; border-radius: 12px;
         background-color: @background; padding: 12px; }
mainbox { children: [inputbar, listview]; spacing: 12px; }
inputbar { padding: 12px; background-color: @surface; border-radius: 8px; }
entry { text-color: @foreground; placeholder: "Search apps, commands, files…"; }
listview { lines: 8; spacing: 4px; }
element { padding: 10px; border-radius: 6px; }
element selected { background-color: @surface; text-color: @accent; }
element-text { text-color: inherit; }
