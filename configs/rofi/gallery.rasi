@import "~/.config/rofi/color.rasi"

window {
padding: 20px;
width: 760px;
border-radius: 40px 0px 80px 0px;
}

mainbox {
children: [listview];
}


listview, {
border: 0px;
margin: 10px;
scrollbar: false;
lines:   2;
columns: 3;
}

element {
children: [ element-icon ];
orientation: vertical;
border-radius: 20px 0px 40px 0px;
border: 1px solid;
}

element selected {
border: 5px solid;
}

element-icon {
size: 112px;
}
