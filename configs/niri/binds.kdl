// KUHL-MANAGED — generated bindings for Niri; adapted from Saatvik Sharma MIT dotfiles.
binds {

    // Start here
    Mod+Space hotkey-overlay-title="Search apps and files" { spawn "sh" "-c" "$HOME/.local/bin/kuhl launcher"; }
    Mod+Return hotkey-overlay-title="Open Alacritty" { spawn "sh" "-c" "alacritty"; }
    Mod+Alt+Return hotkey-overlay-title="Open Kitty" { spawn "sh" "-c" "kitty"; }
    Mod+B hotkey-overlay-title="Open web browser" { spawn "sh" "-c" "firefox"; }
    Mod+E hotkey-overlay-title="Open file manager" { spawn "sh" "-c" "thunar"; }
    Mod+D hotkey-overlay-title="Kuhl Control Center" { spawn "sh" "-c" "$HOME/.local/bin/kuhl menu --ui"; }
    Mod+Shift+S hotkey-overlay-title="Kuhl Settings" { spawn "sh" "-c" "$HOME/.local/bin/kuhl settings"; }
    Ctrl+Super+K hotkey-overlay-title="Search keyboard guide" { spawn "sh" "-c" "$HOME/.local/bin/kuhl keys --ui"; }
    Mod+Shift+T hotkey-overlay-title="Change theme" { spawn "sh" "-c" "$HOME/.local/bin/kuhl themes --ui"; }
    Mod+W hotkey-overlay-title="Change wallpaper" { spawn "sh" "-c" "$HOME/.local/bin/kuhl menu --ui --page themes"; }
    Mod+Shift+P hotkey-overlay-title="Power and session menu" { spawn "sh" "-c" "$HOME/.local/bin/kuhl menu --ui --page power"; }

    // Windows
    Mod+Q hotkey-overlay-title="Close focused window" { close-window; }
    Mod+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+M hotkey-overlay-title="Maximize window" { maximize-column; }
    Mod+V hotkey-overlay-title="Toggle floating window" { toggle-window-floating; }
    Mod+O hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+H hotkey-overlay-title="Focus left" { focus-column-left; }
    Mod+J hotkey-overlay-title="Focus down" { focus-window-down; }
    Mod+K hotkey-overlay-title="Focus up" { focus-window-up; }
    Mod+L hotkey-overlay-title="Focus right" { focus-column-right; }
    Mod+Left hotkey-overlay-title="Focus left" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Focus right" { focus-column-right; }
    Mod+Up hotkey-overlay-title="Focus up" { focus-window-up; }
    Mod+Down hotkey-overlay-title="Focus down" { focus-window-down; }
    Mod+Shift+H hotkey-overlay-title="Move left" { move-column-left; }
    Mod+Shift+J hotkey-overlay-title="Move down" { move-window-down; }
    Mod+Shift+K hotkey-overlay-title="Move up" { move-window-up; }
    Mod+Shift+L hotkey-overlay-title="Move right" { move-column-right; }
    Mod+Comma hotkey-overlay-title="Narrower window" { set-column-width "-10%"; }
    Mod+Period hotkey-overlay-title="Wider window" { set-column-width "+10%"; }
    Mod+R hotkey-overlay-title="Cycle window widths" { switch-preset-column-width; }
    Mod+C hotkey-overlay-title="Center focused column" { center-column; }

    // Workspaces
    Mod+bracketleft hotkey-overlay-title="Previous workspace" { focus-workspace-up; }
    Mod+bracketright hotkey-overlay-title="Next workspace" { focus-workspace-down; }
    Mod+Page_Up hotkey-overlay-title="Previous workspace" { focus-workspace-up; }
    Mod+Page_Down hotkey-overlay-title="Next workspace" { focus-workspace-down; }
    Mod+1 hotkey-overlay-title="Go to workspace 1" { focus-workspace 1; }
    Mod+Ctrl+1 hotkey-overlay-title="Move to workspace 1" { move-column-to-workspace 1; }
    Mod+2 hotkey-overlay-title="Go to workspace 2" { focus-workspace 2; }
    Mod+Ctrl+2 hotkey-overlay-title="Move to workspace 2" { move-column-to-workspace 2; }
    Mod+3 hotkey-overlay-title="Go to workspace 3" { focus-workspace 3; }
    Mod+Ctrl+3 hotkey-overlay-title="Move to workspace 3" { move-column-to-workspace 3; }
    Mod+4 hotkey-overlay-title="Go to workspace 4" { focus-workspace 4; }
    Mod+Ctrl+4 hotkey-overlay-title="Move to workspace 4" { move-column-to-workspace 4; }
    Mod+5 hotkey-overlay-title="Go to workspace 5" { focus-workspace 5; }
    Mod+Ctrl+5 hotkey-overlay-title="Move to workspace 5" { move-column-to-workspace 5; }
    Mod+6 hotkey-overlay-title="Go to workspace 6" { focus-workspace 6; }
    Mod+Ctrl+6 hotkey-overlay-title="Move to workspace 6" { move-column-to-workspace 6; }
    Mod+7 hotkey-overlay-title="Go to workspace 7" { focus-workspace 7; }
    Mod+Ctrl+7 hotkey-overlay-title="Move to workspace 7" { move-column-to-workspace 7; }
    Mod+8 hotkey-overlay-title="Go to workspace 8" { focus-workspace 8; }
    Mod+Ctrl+8 hotkey-overlay-title="Move to workspace 8" { move-column-to-workspace 8; }
    Mod+9 hotkey-overlay-title="Go to workspace 9" { focus-workspace 9; }
    Mod+Ctrl+9 hotkey-overlay-title="Move to workspace 9" { move-column-to-workspace 9; }

    // System & media
    Print hotkey-overlay-title="Screenshot area" { screenshot; }
    Ctrl+Print hotkey-overlay-title="Screenshot monitor" { screenshot-screen; }
    Alt+Print hotkey-overlay-title="Screenshot window" { screenshot-window; }
    Super+Alt+L hotkey-overlay-title="Lock screen" { spawn "sh" "-c" "swaylock -f -c 1e1e2e"; }
    XF86AudioRaiseVolume hotkey-overlay-title="Volume up" { spawn "sh" "-c" "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume hotkey-overlay-title="Volume down" { spawn "sh" "-c" "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute hotkey-overlay-title="Mute audio" { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute hotkey-overlay-title="Mute microphone" { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay hotkey-overlay-title="Play or pause media" { spawn "sh" "-c" "playerctl play-pause"; }
    XF86AudioNext hotkey-overlay-title="Next track" { spawn "sh" "-c" "playerctl next"; }
    XF86AudioPrev hotkey-overlay-title="Previous track" { spawn "sh" "-c" "playerctl previous"; }
    XF86MonBrightnessUp hotkey-overlay-title="Brightness up" { spawn "sh" "-c" "brightnessctl set +10%"; }
    XF86MonBrightnessDown hotkey-overlay-title="Brightness down" { spawn "sh" "-c" "brightnessctl set 10%-"; }
}
