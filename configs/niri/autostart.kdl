// KUHL-MANAGED — KyleOS startup services, Fedora paths and Kuhl wallpaper manager.
// GNOME session remains a separately selectable fallback.
// User-session authorization prompts: network, settings and Flatpak permissions.
spawn-at-startup "sh" "-c" "test ! -x /usr/libexec/polkit-kde-authentication-agent-1 || exec /usr/libexec/polkit-kde-authentication-agent-1"
spawn-at-startup "waybar"
spawn-at-startup "mako" "--default-timeout" "10000"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/kuhl wallpaper apply"
spawn-at-startup "sh" "-c" "command -v vicinae >/dev/null && exec vicinae server || true"
spawn-at-startup "sh" "-c" "command -v nm-applet >/dev/null && exec nm-applet --indicator || true"
spawn-at-startup "sh" "-c" "command -v blueman-applet >/dev/null && exec blueman-applet || true"
spawn-at-startup "swayidle" "-w" "timeout" "900" "swaylock -f -c 0a0a10" "before-sleep" "swaylock -f -c 0a0a10"

// Follow Niri's per-session GTK portal preferences without altering global GNOME at install time.
spawn-at-startup "sh" "-c" "$HOME/.local/bin/kuhl appearance apply"
