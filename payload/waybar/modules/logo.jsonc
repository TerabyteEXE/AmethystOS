{
  // ───────── AmethystOS minimal diamond symbol ─────────
  // Small, accessible Unicode diamond at the bar edge; no icon font required.
  "custom/logo": {
    "format": "<span foreground='#9fb4c0'>◆</span>",
    "tooltip": false,
    "on-click": "fuzzel",
    "on-click-right": "~/.local/bin/amethyst-settings"
  }
}