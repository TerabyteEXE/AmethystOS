{
  // ───────── AmethystOS minimal diamond symbol ─────────
  // Small, accessible Unicode diamond at the bar edge; no icon font required.
  "custom/logo": {
    "format": "<span foreground='#9fb4c0'>◆</span>",
    "tooltip": true,
    "tooltip-format": "Search applications and system actions",
    "on-click": "~/.local/bin/amethyst-launcher",
    "on-click-right": "~/.local/bin/amethyst-hub"
  }
}