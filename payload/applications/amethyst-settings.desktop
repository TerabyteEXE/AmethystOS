[Desktop Entry]
Type=Application
Name=Amethyst Settings
Comment=Manage network, sound, wallpapers and the Niri desktop
Exec=__HOME__/.local/bin/amethyst-settings
Icon=__HOME__/.local/share/amethystos/assets/amethyst-logo.png
Categories=Settings;DesktopSettings;
Keywords=Amethyst;Settings;Appearance;Theme;Desktop;Waybar;Network;Bluetooth;
Terminal=false
StartupNotify=true
