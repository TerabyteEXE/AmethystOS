// Noctalia v5 is a separate, native Wayland shell. Never launch v4 Quickshell here.
spawn-at-startup "noctalia"
spawn-at-startup "amethyst-welcome" "--first-run"
spawn-sh-at-startup "[ -x /usr/libexec/polkit-kde-authentication-agent-1 ] && exec /usr/libexec/polkit-kde-authentication-agent-1"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "systemctl" "--user" "import-environment" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-sh-at-startup "sleep 4; $HOME/.local/bin/amethyst-wallpaper apply-first-use >/dev/null 2>&1"
