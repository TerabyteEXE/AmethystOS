layout {

    focus-ring {
        active-color   "#b68bf2"
        inactive-color "#231b35"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#b68bf2"
        inactive-color "#231b35"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#231b3570"
    }

    tab-indicator {
        active-color   "#b68bf2"
        inactive-color "#8155b2"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#b68bf280"
    }
}

recent-windows {
    highlight {
        active-color "#b68bf2"
        urgent-color "#fd4663"
    }
}
