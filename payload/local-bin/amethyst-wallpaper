#!/usr/bin/env bash
set -Eeuo pipefail
# One-time wallpaper import after Noctalia starts; never overwrite later user selections.
STATE="$HOME/.local/state/amethystos-base-v1"
MODE=${1:-}
case "$MODE" in
  apply-first-use)
    [[ -e "$STATE/noctalia-wallpaper-initialized" ]] && exit 0
    selection="$STATE/wallpaper"
    [[ -r "$selection" ]] || exit 0
    IFS= read -r image <"$selection" || true
    [[ -f "$image" ]] || exit 0
    for i in {1..12}; do
      if command -v qs >/dev/null 2>&1 && qs -c noctalia-shell ipc call wallpaper set "$image" >/dev/null 2>&1; then
        touch "$STATE/noctalia-wallpaper-initialized"
        exit 0
      fi
      sleep 1
    done
    echo "Amethyst wallpaper could not be applied yet; choose it in Noctalia Settings." >&2
    exit 1
    ;;
  dark|light)
    image="$HOME/Pictures/wallpapers/Amethyst${MODE^}.png"
    [[ -f "$image" ]] || exit 1
    qs -c noctalia-shell ipc call wallpaper set "$image"
    mkdir -p "$STATE"; printf '%s\n' "$image" >"$STATE/wallpaper"
    ;;
  *)
    echo 'Usage: amethyst-wallpaper dark|light|apply-first-use' >&2
    exit 2
    ;;
esac
