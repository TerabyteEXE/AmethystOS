#!/usr/bin/env bash
# Top bar preferences: use the persistent GTK Settings window when possible.
# Direct actions stay available for automation and recovery.
set -Eeuo pipefail
PY="$HOME/.local/share/amethystos/bar_config.py"
[[ -r "$PY" ]] || { echo 'AmethystOS bar manager missing. Reinstall AmethystOS.' >&2; exit 1; }
if [[ "${1:-menu}" != menu ]]; then exec python3 "$PY" "$@"; fi
GUI="$HOME/.local/share/amethystos/settings_gui.py"
if [[ -r "$GUI" && -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && \
   python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' >/dev/null 2>&1; then
  exec python3 "$GUI" bar
fi
# Fallback when running without GTK: reopen Fuzzel after applying a choice.
while true; do
  choice=$(printf '%s\n' \
    'Position — top' 'Position — bottom' \
    'Density — compact' 'Density — normal' 'Density — roomy' \
    'Show/hide CPU' 'Show/hide memory' 'Show/hide battery' \
    'Show/hide media player' 'Show/hide Bluetooth' \
    'Show/hide clipboard' 'Show/hide system tray' \
    'Show current bar preferences' 'Done' \
    | fuzzel --dmenu --prompt 'Top bar settings › ' --lines 15 --width 40) || exit 0
  case "$choice" in
    'Position — top') python3 "$PY" position top || true ;;
    'Position — bottom') python3 "$PY" position bottom || true ;;
    'Density — compact') python3 "$PY" density compact || true ;;
    'Density — normal') python3 "$PY" density normal || true ;;
    'Density — roomy') python3 "$PY" density roomy || true ;;
    'Show/hide CPU') python3 "$PY" toggle cpu || true ;;
    'Show/hide memory') python3 "$PY" toggle memory || true ;;
    'Show/hide battery') python3 "$PY" toggle battery || true ;;
    'Show/hide media player') python3 "$PY" toggle player || true ;;
    'Show/hide Bluetooth') python3 "$PY" toggle bluetooth || true ;;
    'Show/hide clipboard') python3 "$PY" toggle clipboard || true ;;
    'Show/hide system tray') python3 "$PY" toggle tray || true ;;
    'Show current bar preferences') python3 "$PY" status || true ;;
    Done|'') exit 0 ;;
  esac
done
