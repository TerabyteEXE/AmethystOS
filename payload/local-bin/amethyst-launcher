#!/usr/bin/env bash
# Toggle a single AmethystOS Fuzzel instance with Super+Space.
# Only signals the PID we launched, never every Fuzzel process on the desktop.
set -Eeuo pipefail
umask 077
runtime="${XDG_RUNTIME_DIR:-$HOME/.cache}"
mkdir -p "$runtime/amethystos"
state="$runtime/amethystos/launcher.pid"
if [[ -f "$state" ]]; then
  read -r pid < "$state" || pid=''
  if [[ "$pid" =~ ^[0-9]+$ ]] && [[ -r "/proc/$pid/cmdline" ]]; then
    args=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    if [[ "$args" == *fuzzel* ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      exit 0
    fi
  fi
  rm -f -- "$state"
fi
if ! command -v fuzzel >/dev/null 2>&1; then
  echo 'AmethystOS: Fuzzel is not installed' >&2; exit 1
fi
# Only actual apps and the single Amethyst Settings entry appear in search.
fuzzel --prompt 'Search applications: ' --lines 10 --width 46 &
pid=$!
printf '%s\n' "$pid" > "$state"
wait "$pid" || true
if [[ -f "$state" ]] && [[ $(cat "$state") == "$pid" ]]; then rm -f -- "$state"; fi
