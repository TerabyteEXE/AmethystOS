#!/usr/bin/env bash
# Super+Space toggles Amethyst's unified, category-filtered launcher.
# Native GTK is preferred; Fuzzel remains the safe fallback if GTK is unavailable.
set -Eeuo pipefail
umask 077
runtime="${XDG_RUNTIME_DIR:-$HOME/.cache}"
mkdir -p "$runtime/amethystos"
state="$runtime/amethystos/launcher.pid"
if [[ -f "$state" ]]; then
  read -r pid < "$state" || pid=''
  if [[ "$pid" =~ ^[0-9]+$ ]] && [[ -r "/proc/$pid/cmdline" ]]; then
    args=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    if [[ "$args" == *launcher_gui.py* || "$args" == *fuzzel* ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      exit 0
    fi
  fi
  rm -f -- "$state"
fi
GUI="$HOME/.local/share/amethystos/launcher_gui.py"
if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" && -r "$GUI" ]] && \
    python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk, Gio' >/dev/null 2>&1; then
  python3 "$GUI" "$@" &
else
  if ! command -v fuzzel >/dev/null 2>&1; then
    echo 'AmethystOS: GTK launcher and Fuzzel are unavailable.' >&2; exit 1
  fi
  # Fallback: clean Apps / Amethyst Menu search, existing desktop entry actions.
  fuzzel --prompt 'Apps / Amethyst Menu: ' --lines 10 --width 54 &
fi
pid=$!
printf '%s\n' "$pid" > "$state"
wait "$pid" || true
if [[ -f "$state" ]] && [[ $(cat "$state") == "$pid" ]]; then rm -f -- "$state"; fi
