#!/usr/bin/env bash
set -u
printf '%s\n' 'AMETHYSTOS · Niri + Gigi/Noctalia v4 diagnostics'
for cmd in niri qs kitty wpctl nmcli fastfetch; do
  if command -v "$cmd" >/dev/null 2>&1; then echo "[ok] $cmd"; else echo "[missing] $cmd"; fi
done
if rpm -q noctalia-legacy >/dev/null 2>&1 || rpm -q noctalia-shell >/dev/null 2>&1; then
  echo '[ok] Noctalia v4 package detected'
else
  echo '[warning] Noctalia legacy v4 package not confirmed (Fedora noctalia v5 is incompatible)'
fi
if command -v niri >/dev/null 2>&1; then niri validate 2>&1 || true; fi
if [[ "${XDG_CURRENT_DESKTOP:-}" != *niri* && "${XDG_CURRENT_DESKTOP:-}" != *Niri* ]]; then
  echo '[info] Run inside a Niri session to check graphical integrations.'
fi
