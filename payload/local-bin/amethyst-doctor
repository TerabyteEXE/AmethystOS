#!/usr/bin/env bash
set -u
printf '%s\n' 'AMETHYSTOS · Fedora + Niri + Noctalia v5 diagnostics'
for cmd in niri noctalia kitty wpctl nmcli fastfetch; do
  if command -v "$cmd" >/dev/null 2>&1; then echo "[ok] $cmd"; else echo "[missing] $cmd"; fi
done
if command -v rpm >/dev/null && rpm -q noctalia >/dev/null 2>&1; then
  echo '[ok] Fedora Noctalia package detected'
else
  echo '[warning] Noctalia v5 package not confirmed'
fi
if command -v niri >/dev/null; then niri validate 2>&1 || true; fi
if command -v noctalia >/dev/null && [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  noctalia msg status 2>&1 || true
fi
