#!/usr/bin/env bash
# Pick a wallpaper with Fuzzel or set a verified image path directly.
set -Eeuo pipefail
WALLDIR="${FUZZEL_WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
SELECTION="$HOME/.local/state/amethystos-base-v1/wallpaper"
mkdir -p "$WALLDIR"

set_wall() {
  local file=$1
  [[ -f "$file" ]] || { printf 'Wallpaper does not exist: %s\n' "$file" >&2; return 1; }
  case "${file##*.}" in
    png|PNG|jpg|JPG|jpeg|JPEG|webp|WEBP) ;;
    *) echo 'Unsupported image format; use PNG, JPEG or WebP.' >&2; return 2 ;;
  esac
  file=$(realpath -- "$file")
  mkdir -p "$(dirname -- "$SELECTION")"
  printf '%s\n' "$file" > "$SELECTION"
  # Don't try to start the wallpaper daemon from a text console.
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v swaybg >/dev/null 2>&1; then
    pkill -x swaybg 2>/dev/null || true
    nohup swaybg -i "$file" -m fill >/dev/null 2>&1 </dev/null &
    disown || true
  fi
  echo "Saved wallpaper: $file"
}

case "${1:-}" in
  --file)
    [[ $# -eq 2 ]] || { echo 'Usage: set-wallpaper --file /path/to/image.png' >&2; exit 2; }
    set_wall "$2"
    exit 0 ;;
  --dark) set_wall "$WALLDIR/AmethystDark.png"; exit 0 ;;
  --light) set_wall "$WALLDIR/AmethystLight.png"; exit 0 ;;
  -h|--help) echo 'Usage: set-wallpaper [--dark | --light | --file IMAGE]'; exit 0 ;;
  '') ;;
  *) echo 'Unknown wallpaper option' >&2; exit 2 ;;
esac

mapfile -d '' files < <(find "$WALLDIR" -maxdepth 1 -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | sort -z)
if (( ${#files[@]} == 0 )); then
  command -v notify-send >/dev/null && notify-send 'Wallpapers' "Add images to $WALLDIR"
  exit 0
fi
names=()
for f in "${files[@]}"; do names+=("${f##*/}"); done
choice=$(printf '%s\n' "${names[@]}" | fuzzel --dmenu --prompt 'Wallpaper: ') || exit 0
[[ -n "$choice" ]] || exit 0
for f in "${files[@]}"; do
  if [[ "${f##*/}" == "$choice" ]]; then
    set_wall "$f"
    exit 0
  fi
done
