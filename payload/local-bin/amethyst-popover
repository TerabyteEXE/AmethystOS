#!/usr/bin/env bash
# Waybar utility panel, with one-instance toggle and GTK fallback.
set -Eeuo pipefail
umask 077
mode="${1:-settings}"
case "$mode" in calendar|audio|network|bluetooth|settings) ;; *) echo 'Unknown panel' >&2; exit 2;; esac
script="$HOME/.local/share/amethystos/bar_popup.py"
if [[ ! -r "$script" ]]; then exec "$HOME/.local/bin/amethyst-settings"; fi
runtime="${XDG_RUNTIME_DIR:-$HOME/.cache}"
mkdir -p "$runtime/amethystos"
state="$runtime/amethystos/bar-popup.pid"
if [[ -f "$state" ]]; then
  read -r pid < "$state" || pid=''
  if [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]]; then
    args=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    if [[ "$args" == *bar_popup.py* ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      exit 0
    fi
  fi
  rm -f -- "$state"
fi
python3 "$script" "$mode" &
pid=$!
printf '%s\n' "$pid" > "$state"
wait "$pid" || true
if [[ -f "$state" ]] && [[ $(cat "$state") == "$pid" ]]; then rm -f -- "$state"; fi
