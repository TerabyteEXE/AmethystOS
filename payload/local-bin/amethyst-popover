#!/usr/bin/env bash
# A bar click toggles its panel; clicking a *different* widget switches panels.
set -Eeuo pipefail
umask 077
mode="${1:-settings}"
case "$mode" in calendar|audio|network|bluetooth|settings) ;; *) echo 'Unknown panel' >&2; exit 2;; esac
script="$HOME/.local/share/amethystos/bar_popup.py"
if [[ ! -r "$script" ]]; then exec "$HOME/.local/bin/amethyst-settings"; fi
runtime="${XDG_RUNTIME_DIR:-$HOME/.cache}"
mkdir -p "$runtime/amethystos"
state="$runtime/amethystos/bar-popup.pid"
mode_file="$runtime/amethystos/bar-popup.mode"
if [[ -f "$state" ]]; then
  read -r pid < "$state" || pid=''
  if [[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/cmdline" ]]; then
    args=$(tr '\0' ' ' < "/proc/$pid/cmdline")
    if [[ "$args" == *bar_popup.py* ]]; then
      oldmode=$(cat "$mode_file" 2>/dev/null || true)
      kill -TERM "$pid" 2>/dev/null || true
      if [[ "$oldmode" == "$mode" ]]; then
        rm -f -- "$state" "$mode_file"
        exit 0
      fi
      # Different widget: close the first popup and open the requested one.
    fi
  fi
  rm -f -- "$state" "$mode_file"
fi
python3 "$script" "$mode" &
pid=$!
printf '%s\n' "$pid" > "$state"
printf '%s\n' "$mode" > "$mode_file"
wait "$pid" || true
if [[ -f "$state" ]] && [[ $(cat "$state") == "$pid" ]]; then
  rm -f -- "$state" "$mode_file"
fi
