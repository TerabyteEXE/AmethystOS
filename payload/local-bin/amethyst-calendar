#!/usr/bin/env bash
set -Eeuo pipefail
helper="$HOME/.local/share/amethystos/calendar_gui.py"
if [[ -r "$helper" ]] && python3 -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk' >/dev/null 2>&1; then
  exec python3 "$helper"
fi
if command -v alacritty >/dev/null 2>&1; then
  exec alacritty -e bash -lc 'date; echo; if command -v cal >/dev/null; then cal -3; fi; read -r -p "Press Enter to close"'
fi
printf 'Amethyst calendar — %s\n' "$(date '+%A %d %B %Y')"
